# Experimental Isaac Sim 5.1 image for NVIDIA drivers newer than the validated
# R580 branch. Build from the workspace containing Robolab, molmoact2, and duet-dino. 
# Bind the host assets directory to receive downloaded assets:
# apptainer build --bind "$PWD/Robolab/assets:/mnt/robolab-assets" Robolab.sif Robolab/docker/Apptainer_pip.def

Bootstrap: docker
From: nvcr.io/nvidia/isaac-lab:{{ ISAACLAB_TAG }}

%arguments
    ISAACLAB_TAG=2.3.0
    OPENPI_COMMIT=aa6420561529593114160d05e5ad155792b272f3
    VULKAN_PROFILES_COMMIT=a400d0b10059b2cc3cd285475593eee79975a5c4

%setup
    set -eu
    mkdir -p "${APPTAINER_ROOTFS:?}/mnt/robolab-assets"

%files
    Robolab/. /workspace/robolab
    molmoact2/. /workspace/molmoact2
    duet-dino/. /workspace/duet-dino

%post
    set -eu
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        htop \
        iputils-ping \
        git-lfs \
        ninja-build \
        nvtop \
        python3-jsonschema \
        rsync \
        util-linux \
        tmux \
        vim \
        zip \
        zstd
    rm -rf /var/lib/apt/lists/*

    # Download using the container's Git LFS, then export assets
    git -C /workspace/robolab -c safe.directory=/workspace/robolab \
        lfs pull --include="assets/**" --exclude=""
    rsync -r --checksum /workspace/robolab/assets/ /mnt/robolab-assets/

    ################## ROBOLAB INSTALLATION #####################
    /workspace/isaaclab/_isaac_sim/python.sh -m pip install \
        --no-cache-dir \
        --no-deps \
        "openpi-client @ git+https://github.com/xuningy/openpi@{{ OPENPI_COMMIT }}#subdirectory=packages/openpi-client"

    cd /workspace/robolab
    /workspace/isaaclab/_isaac_sim/python.sh -m pip install \
        --no-cache-dir "docstring-parser==0.16"
    GIT_LFS_SKIP_SMUDGE=1 /workspace/isaaclab/_isaac_sim/python.sh \
        -m pip install --no-cache-dir -e .
    install -d /workspace/robolab/output

    ##################### DUET-DINO INSTALLATION #################
    /workspace/isaaclab/_isaac_sim/python.sh -m pip install \
        --no-cache-dir --no-deps timm einops
    cd /workspace/duet-dino
    GIT_LFS_SKIP_SMUDGE=1 /workspace/isaaclab/_isaac_sim/python.sh \
        -m pip install --no-cache-dir --no-deps -e .
    cd /workspace/robolab
    install -d /workspace/duet-dino/checkpoints

    ################### MOLMOACT2 INSTALLATION ######################
    
    /workspace/isaaclab/_isaac_sim/python.sh -m pip install \
        --no-cache-dir virtualenv
    /workspace/isaaclab/_isaac_sim/python.sh -m virtualenv /opt/venvs/molmoact2

    # Read dependencies from the copied project without packaging its examples
    # or experiments. pip does not use the project's tool.uv index settings.
    /opt/venvs/molmoact2/bin/python - <<'PYDEPS'
from pathlib import Path
import sys
import tomllib

assert (3, 11) <= sys.version_info[:2] < (3, 13), "MolmoAct2 requires Python 3.11 or 3.12"
project = tomllib.loads(Path("/workspace/molmoact2/pyproject.toml").read_text())
deps = project["project"]["dependencies"]
Path("/tmp/molmoact2-torch.txt").write_text(
    "\n".join(dep for dep in deps if dep.startswith(("torch==", "torchvision=="))) + "\n"
)
Path("/tmp/molmoact2-requirements.txt").write_text("\n".join(deps) + "\n")
PYDEPS
    /opt/venvs/molmoact2/bin/python -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu128 \
        -r /tmp/molmoact2-torch.txt
    /opt/venvs/molmoact2/bin/python -m pip install --no-cache-dir \
        -r /tmp/molmoact2-requirements.txt
    /opt/venvs/molmoact2/bin/python -m pip check
    rm -f /tmp/molmoact2-torch.txt /tmp/molmoact2-requirements.txt

    # Checkpoints are supplied via a writable runtime bind mount.
    install -d /workspace/molmoact2/models/huggingface

    # Build the pinned Khronos Profiles layer inside this Ubuntu image.
    # UPDATE_DEPS builds jsoncpp 1.9.6 as a static library, avoiding the
    # Arch package incompatible runtime dependency on libjsoncpp.so.26.
    compat_root=/opt/vulkan-rtx-compat
    profiles_src=/tmp/Vulkan-Profiles
    profiles_build=/tmp/Vulkan-Profiles-build
    install -d \
        "$compat_root/profiles" \
        "$compat_root/share/vulkan/implicit_layer.d"
    git clone --filter=blob:none --no-checkout \
        https://github.com/KhronosGroup/Vulkan-Profiles.git "$profiles_src"
    git -C "$profiles_src" checkout --detach {{ VULKAN_PROFILES_COMMIT }}
    cmake -S "$profiles_src" -B "$profiles_build" -G Ninja \
        -D CMAKE_BUILD_TYPE=Release \
        -D BUILD_TESTS=OFF \
        -D UPDATE_DEPS=ON
    cmake --build "$profiles_build" --target ProfilesLayer --parallel
    install -m 0755 \
        "$profiles_build/layer/libVkLayer_khronos_profiles.so" \
        "$compat_root/libVkLayer_khronos_profiles.so"

    # The layer must be self-contained with respect to jsoncpp.
    if ldd "$compat_root/libVkLayer_khronos_profiles.so" | grep -q libjsoncpp; then
        echo "ERROR: Vulkan Profiles layer unexpectedly links dynamic jsoncpp" >&2
        exit 1
    fi
    install -m 0644 docker/vulkan-rtx-compat/VP_RTX_driver_compat_generated.json \
        "$compat_root/profiles/VP_RTX_driver_compat_generated.json"
    install -m 0644 docker/vulkan-rtx-compat/VkLayer_KHRONOS_profiles.json \
        "$compat_root/share/vulkan/implicit_layer.d/VkLayer_KHRONOS_profiles.json"
    install -m 0755 docker/vulkan-rtx-compat/python-rtx-compat \
        /usr/local/bin/python-rtx-compat
    rm -rf "$profiles_src" "$profiles_build"

%environment
    export ROBOLAB_PYTHON=/workspace/isaaclab/_isaac_sim/python.sh
    export OMNI_KIT_ACCEPT_EULA=YES
    export ACCEPT_EULA=Y
    export MOLMOACT2_ENV=/opt/venvs/molmoact2/bin/activate
    export HF_HOME=/workspace/molmoact2/models/huggingface
    export HF_HUB_ENABLE_HF_TRANSFER=1
    
%labels
    org.opencontainers.image.title RoboLab
    org.opencontainers.image.description "RoboLab with experimental Vulkan RTX driver compatibility profile"

%help
    Bind a Hugging Face cache containing the downloaded checkpoints:
        apptainer exec --nv --bind /path/to/hf-cache:/workspace/molmoact2/models/huggingface IMAGE.sif \
            /opt/venvs/molmoact2/bin/python \
            /workspace/molmoact2/examples/droid/host_server_droid.py --dtype bfloat16

    The cache must retain its hub/models--allenai--MolmoAct2-DROID layout.
    Use a writable bind: the server patches checkpoint Python files for bf16.

